# ============================================================
# purchase-engine (Next.js) — exemple de configuration
# Copier vers .env.local et adapter. Variables publiques : jamais de secret ici. Prises en compte au build.
# ============================================================

# Agrégateur de paiement : contexte, codes promo, devis et initialisation du paiement
NEXT_PUBLIC_AGGREGATOR_URL=http://localhost:3000
# Frontend NewStudies : retour vers la formation et le catalogue depuis les pages /success, /cancel, /failed
NEXT_PUBLIC_SL_FRONTEND_URL=http://localhost:3004

# Relais serveur vers l'agrégateur (côté serveur uniquement, jamais exposé au navigateur)
AGGREGATOR_URL=http://localhost:3000

# Salle d'attente des pics d'affluence (ADR-0021, C5) — invisible sous le seuil
# QUEUE_ENABLED=true
# Paiements simultanés acceptés avant d'ouvrir la file
# QUEUE_CAPACITY=300
# Admissions par seconde quand la file est ouverte (évite la ruée vers l'agrégateur)
# QUEUE_RATE=8
# Secondes d'inactivité avant de rendre la place à la file
# QUEUE_PASS_TTL=600
# Signature des places : OBLIGATOIRE dès qu'il y a plusieurs instances (même valeur partout)
# QUEUE_SECRET=
# État partagé entre instances (sans lui : mémoire, une seule instance)
# REDIS_URL=redis://127.0.0.1:6379
